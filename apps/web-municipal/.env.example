# Copia este archivo a .env.local para personalizar el desarrollo local.
# Estos son los valores predeterminados cuando no se definen las variables.
# Las variables NEXT_PUBLIC_* son públicas y se fijan al compilar con Next.js.

# Modos admitidos: mock | api-stub | api.
NEXT_PUBLIC_API_MODE=mock
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Clave pública opcional de CARTO Basemaps (visible en el navegador).
# CARTO Positron vectorial permite actualmente solicitar el estilo sin clave.
# Una variable vacía no bloquea el mapa; la cartografía requiere conexión.
# Si CARTO exige una clave, solicitarla en https://carto.com/basemaps/apikey.
# Configurar el valor propio en .env.local; nunca usar un token de ALERVI aquí.
NEXT_PUBLIC_CARTO_BASEMAP_KEY=
