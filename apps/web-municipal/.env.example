# Copia este archivo a .env.local para personalizar el desarrollo local.
# Estos son los valores predeterminados cuando no se definen las variables.
# Las variables NEXT_PUBLIC_* son públicas y se fijan al compilar con Next.js.

# Modos admitidos: mock | api-stub | api.
NEXT_PUBLIC_API_MODE=mock
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Clave pública de CARTO Basemaps para Positron (visible en el navegador).
# Solicitar en https://carto.com/basemaps/apikey y configurar en .env.local.
# Sin ella, los puntos y la lista funcionan y el mapa base indica indisponibilidad.
NEXT_PUBLIC_CARTO_BASEMAP_KEY=
