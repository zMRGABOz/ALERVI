# ============================================================
# ALERVI — Variables de Entorno (Ejemplo)
# ============================================================
# Copiar este archivo como .env y completar los valores:
#   cp .env.example .env
# ⚠️ NUNCA subir .env a Git
# ============================================================

# ---- Base de Datos (PostgreSQL + PostGIS) ----
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=alervi_db
POSTGRES_USER=alervi_user
POSTGRES_PASSWORD=cambiar_esta_password

# ---- Backend (FastAPI) ----
BACKEND_PORT=8000
BACKEND_SECRET_KEY=cambiar_esta_clave_secreta
BACKEND_DEBUG=true
BACKEND_CORS_ORIGINS=http://localhost:3000

# ---- API Externa CONASET ----
CONASET_API_BASE_URL=https://api.conaset.cl/v1
# CONASET_API_KEY=  # Solo si requiere autenticación

# ---- Frontend Web (Next.js) ----
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_MAPBOX_TOKEN=pk.xxxxxxxxxxxxxxxx

# ---- App Móvil ----
MOBILE_API_URL=http://10.0.2.2:8000
# 10.0.2.2 es localhost del host desde el emulador Android

# ---- Mapbox / Google Maps ----
MAPBOX_ACCESS_TOKEN=pk.xxxxxxxxxxxxxxxx
# GOOGLE_MAPS_API_KEY=AIzaxxxxxxxxxxxxxxx
